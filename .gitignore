.settings
#.vscode
# Anchored: this is the Eclipse output directory at the repository root, not
# any directory named "debug" - an unanchored pattern also swallowed
# src/debug/, so new files there would never have been offered for commit.
/debug/
make/build
tests/build
.DS_Store
.project
# Built from a real IWAD by tools/wadpack.py - carries the WAD artwork,
# so it stays out of the repository
# The asset packs: both halves carry id Software artwork, and --split writes
# the second one beside the first
doom/doom_assets.bin
doom/doom_assets_tex.bin

# iCloud Drive keeps both sides of a conflict and appends a space and a
# number to the loser: "measure 2.c", "hoststub 2/". The copy is stale the
# moment it is made, so it must never be committed. tools/git-hooks/pre-commit
# refuses one that gets staged anyway.
* [0-9]
* [0-9].*
*.icloud

# Python bytecode from importing tools/ as a module
__pycache__/
