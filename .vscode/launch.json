{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (OpenOCD)",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/make/build/open-5012h.elf",
            "request": "launch",
            "type": "cortex-debug",
            "preLaunchTask": "Build embedded project",
            "servertype": "openocd",
            "interface": "swd",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            "device": "GD32F407VET",
            "runToEntryPoint": "main",
            // Resolved from OpenOCD's own script directory, so this keeps
            // working after a openocd upgrade moves the Cellar path. Any
            // CMSIS-DAP probe works; interface/wch-cmsis-dap.cfg is the
            // WCH-Link variant. GD32F4 is programmed as an STM32F4.
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "openOCDLaunchCommands": [
                "transport select swd",
                "adapter speed 2000"
            ],
            "preLaunchCommands": [
                "set mem inaccessible-by-default off",
                "monitor reset"
            ],
            "postLaunchCommands": [
                "monitor reset init",
                "monitor sleep 100"
            ],
            "showDevDebugOutput": "raw",
            "gdbPath": "/opt/homebrew/bin/arm-none-eabi-gdb"
        }
    ]
}
